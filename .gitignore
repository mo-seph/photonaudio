# PlatformIO build output and library cache
.pio/
.vscode/

# Python
__pycache__/
.pytest_cache/

# macOS
.DS_Store

# Raw audio recordings: measurement runs keep their analysed results
# (CSV, PNG, JSON) in git, the WAVs stay local. Re-running
# `linkmeasure.py reanalyse` needs a run's sweep_recorded.wav.
*.wav
*.aif
*.aiff
*.mp3

# Eagle / Fusion Electronics backup files
*.s#?
*.b#?
*.l#?

# KiCad: per-user settings folder (KICAD_DOCUMENTS_HOME), lock files, backups,
# local view settings, caches and check reports
kicad/kicad-user/
~*.lck
*-backups/
*.kicad_prl
fp-info-cache
*.rpt

# Local-only notes or secrets
*.local.*
